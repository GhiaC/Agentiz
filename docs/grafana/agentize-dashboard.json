{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus scraping the Agentize /agentize/metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "annotations": { "list": [ { "builtIn": 1, "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true, "hide": true, "name": "Annotations & Alerts", "type": "dashboard" } ] },
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["agentize", "framework", "overview"],
  "templating": {
    "list": [
      { "current": {}, "hide": 0, "includeAll": false, "label": "Data source", "multi": false, "name": "datasource", "options": [], "query": "prometheus", "refresh": 1, "type": "datasource" }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "Agentize — Framework Overview",
  "uid": "agentize-overview",
  "version": 1,
  "panels": [
    { "type": "row", "id": 1, "title": "Messages", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 } },
    {
      "type": "timeseries", "id": 2, "title": "Messages by layer & status (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (layer, status) (rate(agentize_message_processed_total[5m])) * 60", "legendFormat": "{{layer}} / {{status}}" } ]
    },
    {
      "type": "timeseries", "id": 3, "title": "Message latency p95 by layer",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum by (le, layer) (rate(agentize_message_duration_seconds_bucket[10m])))", "legendFormat": "{{layer}}" } ]
    },
    {
      "type": "timeseries", "id": 4, "title": "In-progress & queued",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "agentize_message_in_progress", "legendFormat": "in-progress {{layer}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (layer) (rate(agentize_message_queued_total[5m])) * 60", "legendFormat": "queued/min {{layer}}" }
      ]
    },

    { "type": "row", "id": 10, "title": "LLM", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 } },
    {
      "type": "timeseries", "id": 11, "title": "LLM calls by purpose & status (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (purpose, status) (rate(agentize_llm_calls_total[5m])) * 60", "legendFormat": "{{purpose}} / {{status}}" } ]
    },
    {
      "type": "timeseries", "id": 12, "title": "LLM latency p95 by purpose",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum by (le, purpose) (rate(agentize_llm_call_duration_seconds_bucket[10m])))", "legendFormat": "{{purpose}}" } ]
    },
    {
      "type": "timeseries", "id": 13, "title": "Token throughput by type (/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (type) (rate(agentize_llm_tokens_total[5m]))", "legendFormat": "{{type}}" } ]
    },

    { "type": "row", "id": 20, "title": "Tools, Agents & Backups", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 } },
    {
      "type": "timeseries", "id": 21, "title": "Tool calls by tool & status (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (tool, status) (rate(agentize_tool_calls_total[5m])) * 60", "legendFormat": "{{tool}} / {{status}}" } ]
    },
    {
      "type": "timeseries", "id": 22, "title": "Agent routing & escalations (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (agent, status) (rate(agentize_agent_routing_total[5m])) * 60", "legendFormat": "route {{agent}}/{{status}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (agent) (rate(agentize_agent_escalations_total[15m])) * 60", "legendFormat": "escalate {{agent}}" }
      ]
    },
    {
      "type": "timeseries", "id": 23, "title": "Backup-LLM fallbacks (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (provider, status) (rate(agentize_backup_llm_total[15m])) * 60", "legendFormat": "{{provider}} / {{status}}" } ]
    },

    { "type": "row", "id": 30, "title": "Scheduler (background worker)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 } },
    {
      "type": "stat", "id": 31, "title": "Scheduler running",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 4, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "blue", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(agentize_scheduler_running)" } ]
    },
    {
      "type": "timeseries", "id": 32, "title": "Summaries produced (/min) & errors",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 10, "x": 4, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (status) (rate(agentize_scheduler_summaries_total[15m])) * 60", "legendFormat": "{{status}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (status) (rate(agentize_scheduler_runs_total[1h])) * 60", "legendFormat": "run {{status}}" }
      ]
    },
    {
      "type": "timeseries", "id": 33, "title": "Cycle & summary duration p95",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 10, "x": 14, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, rate(agentize_scheduler_run_duration_seconds_bucket[1h]))", "legendFormat": "cycle p95" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, rate(agentize_scheduler_summary_duration_seconds_bucket[1h]))", "legendFormat": "summary p95" }
      ]
    },

    { "type": "row", "id": 40, "title": "Knowledge, Moderation, Planning & Runtime", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 } },
    {
      "type": "timeseries", "id": 41, "title": "Moderation results (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 6, "x": 0, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (result) (rate(agentize_moderation_checks_total[15m])) * 60", "legendFormat": "{{result}}" } ]
    },
    {
      "type": "timeseries", "id": 42, "title": "Knowledge opens & plan steps (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 6, "x": 6, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "line", "fillOpacity": 20 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (status) (rate(agentize_knowledge_file_opens_total[15m])) * 60", "legendFormat": "open {{status}}" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (status) (rate(agentize_planning_steps_total[15m])) * 60", "legendFormat": "plan step {{status}}" }
      ]
    },
    {
      "type": "timeseries", "id": 43, "title": "Goroutines",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 6, "x": 12, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "go_goroutines{job=\"agentize\"}", "legendFormat": "goroutines" } ]
    },
    {
      "type": "timeseries", "id": 44, "title": "Resident memory",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 6, "x": 18, "y": 37 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "process_resident_memory_bytes{job=\"agentize\"}", "legendFormat": "RSS" } ]
    },

    { "type": "row", "id": 50, "title": "Files (file manager) & Bans", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 } },
    {
      "type": "timeseries", "id": 51, "title": "File operations by action (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 6, "x": 0, "y": 45 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (operation, status) (rate(agentize_file_operations_total[5m])) * 60", "legendFormat": "{{operation}} / {{status}}" } ]
    },
    {
      "type": "timeseries", "id": 52, "title": "File op latency p95 by operation",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 6, "x": 6, "y": 45 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(agentize_file_operation_duration_seconds_bucket[10m])))", "legendFormat": "{{operation}}" } ]
    },
    {
      "type": "timeseries", "id": 53, "title": "File bytes moved (/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 6, "x": 12, "y": 45 },
      "fieldConfig": { "defaults": { "unit": "binBps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (direction) (rate(agentize_file_bytes_total[5m]))", "legendFormat": "{{direction}}" } ]
    },
    {
      "type": "timeseries", "id": 54, "title": "Bans applied by reason (/h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 6, "x": 18, "y": 45 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (reason) (rate(agentize_moderation_bans_total[1h])) * 3600", "legendFormat": "{{reason}}" } ]
    },

    { "type": "row", "id": 60, "title": "Image editing", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 } },
    {
      "type": "timeseries", "id": 61, "title": "Image edits by model & status (/min)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 8, "x": 0, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "cpm", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (model, status) (rate(agentize_image_edits_total[15m])) * 60", "legendFormat": "{{model}} / {{status}}" } ]
    },
    {
      "type": "timeseries", "id": 62, "title": "Image edit latency p95 by model",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 8, "x": 8, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum by (le, model) (rate(agentize_image_edit_duration_seconds_bucket[1h])))", "legendFormat": "{{model}}" } ]
    },
    {
      "type": "timeseries", "id": 63, "title": "Image edit bytes (/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 8, "x": 16, "y": 53 },
      "fieldConfig": { "defaults": { "unit": "binBps", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (direction) (rate(agentize_image_edit_bytes_total[5m]))", "legendFormat": "{{direction}}" } ]
    },

    { "type": "row", "id": 70, "title": "Storage & Audit", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 60 } },
    {
      "type": "timeseries", "id": 71, "title": "Store query latency p95 by operation & backend",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 0, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, sum by (le, operation, backend) (rate(agentize_store_query_duration_seconds_bucket[10m])))", "legendFormat": "{{operation}} / {{backend}}" } ]
    },
    {
      "type": "timeseries", "id": 72, "title": "Store ops by operation (/s)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 8, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 20, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (operation) (rate(agentize_store_query_duration_seconds_count[5m]))", "legendFormat": "{{operation}}" } ]
    },
    {
      "type": "timeseries", "id": 73, "title": "Summary age at refresh (p50 / p95)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 8, "w": 8, "x": 16, "y": 61 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.5, rate(agentize_summary_age_seconds_bucket[1h]))", "legendFormat": "p50" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "histogram_quantile(0.95, rate(agentize_summary_age_seconds_bucket[1h]))", "legendFormat": "p95" }
      ]
    },
    {
      "type": "timeseries", "id": 74, "title": "Audit actions (/h) by action & status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" }, "gridPos": { "h": 7, "w": 8, "x": 0, "y": 69 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (action, status) (rate(agentize_audit_actions_total[1h])) * 3600", "legendFormat": "{{action}} / {{status}}" } ]
    },
    {

      "targets": [ { "refId": "A", "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "sum by (entity) (rate(agentize_store_deletions_total[1h])) * 3600", "legendFormat": "{{entity}}" } ]
    }
  ]
}
